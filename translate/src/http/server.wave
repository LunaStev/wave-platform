import("std::net::tcp")::{
    TcpStream, TcpListener, tcp_bind_loopback, tcp_accept, tcp_close,
    tcp_close_listener, tcp_read_timeout, tcp_write_timeout
};
import("std::net::error")::{NetResult, NetIoResult, NET_ERROR_NONE, NET_ERROR_TIMED_OUT};
import("std::time::clock")::{time_now_monotonic_ns};
import("std::string::len")::{len};
import("./request")::{Request, header_end, parse_request, matches};

fun remaining_ms(deadline: i64) -> i32 {
    var now: i64 = time_now_monotonic_ns();
    if (now < 0 || now >= deadline) {
        return 0;
    }
    return ((deadline - now) / 1000000 + 1) as i32;
}

fun send_bytes(stream: TcpStream, data: ptr<u8>, size: i64, deadline: i64) -> bool {
    var offset: i64 = 0;
    while (offset < size) {
        var remaining: i32 = remaining_ms(deadline);
        if (remaining == 0) {
            return false;
        }
        var written: NetIoResult = tcp_write_timeout(stream, &data[offset], size - offset, remaining);
        if (written.error.kind != NET_ERROR_NONE || written.count <= 0) {
            return false;
        }
        offset += written.count;
    }
    return true;
}

fun send_text(stream: TcpStream, text: str, deadline: i64) -> bool {
    return send_bytes(stream, text as ptr<u8>, len(text) as i64, deadline);
}

fun status_line(status: i32) -> str {
    if (status == 200) { return "HTTP/1.1 200 OK\r\n"; }
    if (status == 404) { return "HTTP/1.1 404 Not Found\r\n"; }
    if (status == 405) { return "HTTP/1.1 405 Method Not Allowed\r\n"; }
    if (status == 408) { return "HTTP/1.1 408 Request Timeout\r\n"; }
    if (status == 413) { return "HTTP/1.1 413 Content Too Large\r\n"; }
    if (status == 431) { return "HTTP/1.1 431 Request Header Fields Too Large\r\n"; }
    if (status == 501) { return "HTTP/1.1 501 Not Implemented\r\n"; }
    if (status == 503) { return "HTTP/1.1 503 Service Unavailable\r\n"; }
    if (status == 505) { return "HTTP/1.1 505 HTTP Version Not Supported\r\n"; }
    return "HTTP/1.1 400 Bad Request\r\n";
}

fun respond(stream: TcpStream, request: Request, ready_body: str) {
    var body: str = "{\"error\":\"request_rejected\"}\n";
    if (request.status == 200) {
        body = "{\"service\":\"wave-translation\",\"status\":\"ok\"}\n";
    }
    if (request.route == 2) {
        body = ready_body;
    }
    var deadline: i64 = time_now_monotonic_ns();
    if (deadline < 0) { return; }
    deadline += 2000000000;
    if (!send_text(stream, status_line(request.status), deadline)) { return; }
    if (!send_text(stream, "Connection: close\r\nContent-Type: application/json; charset=utf-8\r\nCache-Control: no-store\r\n", deadline)) { return; }
    if (request.status == 405) {
        if (!send_text(stream, "Allow: GET, HEAD\r\n", deadline)) { return; }
    }
    if (!send_text(stream, "Content-Length: ", deadline)) { return; }
    var digits: array<u8, 20>;
    var cursor: i64 = 20;
    var size: i64 = len(body) as i64;
    while (true) {
        cursor -= 1;
        digits[cursor] = (48 + size % 10) as u8;
        size /= 10;
        if (size == 0) { break; }
    }
    if (!send_bytes(stream, &digits[cursor], 20 - cursor, deadline)) { return; }
    if (!send_text(stream, "\r\n\r\n", deadline)) { return; }
    if (!request.head_only) {
        send_text(stream, body, deadline);
    }
}

fun handle(stream: TcpStream, ready_body: str) {
    var data: array<u8, 8192>;
    var used: i64 = 0;
    var deadline: i64 = time_now_monotonic_ns();
    if (deadline < 0) { return; }
    deadline += 2000000000;
    var result: Request = Request { status: 400, route: 0, head_only: false };
    while (true) {
        var remaining: i32 = remaining_ms(deadline);
        if (remaining == 0) {
            result.status = 408;
            break;
        }
        var received: NetIoResult = tcp_read_timeout(stream, &data[used], 8192 - used, remaining);
        if (received.error.kind == NET_ERROR_TIMED_OUT) {
            result.status = 408;
            break;
        }
        if (received.error.kind != NET_ERROR_NONE || received.count == 0) {
            return;
        }
        used += received.count;
        var end: i64 = header_end(&data[0], used);
        if (end > 0) {
            result = parse_request(&data[0], end);
            break;
        }
        if (used == 8192) {
            result.status = 431;
            break;
        }
    }
    // A recognized HEAD method also suppresses bodies on timeout/size errors.
    if (used >= 5 && matches(&data[0], 0, 5, "HEAD ", false)) {
        result.head_only = true;
    }
    respond(stream, result, ready_body);
}

pub fun serve(port: u16, ready_body: str) -> i32 {
    var bound: NetResult<TcpListener> = tcp_bind_loopback(port);
    if (!bound.ok) {
        println("Cannot bind Wave Translation: error={}", bound.error.native_code);
        return 1;
    }
    println("Wave Translation listening on 127.0.0.1:{}", port);
    while (true) {
        var accepted: NetResult<TcpStream> = tcp_accept(bound.value);
        if (!accepted.ok) {
            tcp_close_listener(bound.value);
            return 2;
        }
        handle(accepted.value, ready_body);
        tcp_close(accepted.value);
    }
    return 0;
}
